# Helfy Shop — Environment Variables
# Copy this file to .env and adjust values if needed.
# docker-compose.yml has safe defaults for every variable so .env is OPTIONAL.

# ── Database ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=helfy
MYSQL_USER=helfy
MYSQL_PASSWORD=helfypassword

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=3000
JWT_SECRET=changeme_use_a_long_random_string_in_production
JWT_EXPIRY=7d
BCRYPT_ROUNDS=10

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origin that the backend will accept. In compose this is the nginx host seen by browsers.
CORS_ORIGIN=http://localhost:8080
